# Nightscout / Render / MongoDB setup example
# Copy values into Render Environment Variables.
# Do NOT commit real secrets, database passwords, API secrets, CareLink credentials, or tokens.

# Required for Render/Nightscout
HOSTNAME=0.0.0.0
PORT=1337
NODE_ENV=production
TZ=Europe/Amsterdam

# Required: paste only into Render, never into GitHub
MONGODB_URI=mongodb+srv://nightscout:<DATABASE_PASSWORD>@<CLUSTER_HOST>/nightscout?retryWrites=true&w=majority
API_SECRET=<LONG_UNIQUE_NIGHTSCOUT_SECRET_MIN_12_CHARS>

# Display and security
DISPLAY_UNITS=mmol/L
TIME_FORMAT=24
AUTH_DEFAULT_ROLES=denied

# Core Nightscout plugins for visibility only
ENABLE=careportal iob sage cage basal dbsize

# Optional alarm thresholds in mmol/L
BG_TARGET_BOTTOM=4.5
BG_TARGET_TOP=13

# Stale-data principle for Garmin use:
# Data older than 10 minutes must be treated as STALE / NOT RELIABLE.
# This is documented for the Garmin setup; exact display behavior depends on the chosen Connect IQ data field.
